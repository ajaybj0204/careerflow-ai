# CareerFlow AI environment variables.
# Copy to apps/web/.env.local for local development (never commit real values).
# With nothing set, the app runs in LOCAL TEST MODE: local PGlite database, local file storage,
# a password-less development sign-in, and no AI/Gmail. Every value below enables a real integration.

# --- App ---------------------------------------------------------------------------
APP_URL=http://localhost:3100
# Signs local session cookies and OAuth state. Required in production. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase (auth, Postgres, storage) --------------------------------------------
# Setting these switches sign-in to Google via Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for private Storage access and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase → Project Settings → Database → Transaction pooler, port 6543).
# When set, the app uses Postgres instead of local PGlite.
DATABASE_URL=

# --- Google OAuth for Gmail (separate from sign-in) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts Google tokens at rest (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional: Gmail push notifications via Google Cloud Pub/Sub
GMAIL_PUBSUB_TOPIC=            # projects/<project-id>/topics/<topic>
PUBSUB_PUSH_AUDIENCE=          # e.g. https://your-app.vercel.app/api/gmail/push
PUBSUB_SERVICE_ACCOUNT_EMAIL=  # service account used by the push subscription
GMAIL_POLL_MINUTES=30          # polling fallback interval

# --- AI (Google Gemini) ------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Job discovery -------------------------------------------------------------------
# Free API key from https://developer.adzuna.com/ for Indian job listings
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# DISABLE_REMOTIVE=true
# DISABLE_ARBEITNOW=true

# --- Background jobs -----------------------------------------------------------------
# Protects /api/cron/tick. Required in production. Used by Vercel Cron, GitHub Actions or apps/worker.
CRON_SECRET=
JOBS_PER_TICK=25
# Worker only:
WORKER_INTERVAL_SECONDS=60

# --- Documents -----------------------------------------------------------------------
# Optional: path to LibreOffice for exact DOCX→PDF conversion (otherwise a simplified PDF is produced)
SOFFICE_PATH=

# --- Local development only ------------------------------------------------------------
# CAREERFLOW_DATA_DIR=./.data/pglite
# CAREERFLOW_STORAGE_DIR=./.data/storage
# ALLOW_LOCAL_AUTH=true            # allow the dev sign-in in a production build (testing only)
# ALLOW_LOCAL_DB_IN_PRODUCTION=true
