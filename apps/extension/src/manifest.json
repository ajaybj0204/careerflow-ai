{
  "manifest_version": 3,
  "name": "CareerFlow AI Companion",
  "version": "0.2.1",
  "description": "Fill job application forms from your CareerFlow profile, save postings, and track applications. Never submits for you.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerFlow AI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this job application with CareerFlow"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}